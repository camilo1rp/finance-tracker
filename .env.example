DATABASE_URL=postgresql+psycopg://finance:finance@db:5432/finance
# Model for coordinator, analyst, and steward. Examples:
#   anthropic:claude-sonnet-4-6  (needs ANTHROPIC_API_KEY)
#   openai:gpt-4o                (needs OPENAI_API_KEY)
STEWARD_MODEL=anthropic:claude-sonnet-4-6
# Optional override for the enricher. Empty falls back to STEWARD_MODEL.
# ENRICHER_MODEL=
AGENT_CHECKPOINT_PATH=.agent_checkpoints.sqlite

# Email enrichment source: none | fake | gmail_rest | gmail.
# gmail_rest is the primary Gmail provider (any Google account, Gmail API).
# gmail is the MCP adapter and requires Workspace Developer Preview enrollment.
EMAIL_PROVIDER=none
# Comma-separated sender patterns. Empty means nothing allowed. Use * to allow all.
EMAIL_SENDER_ALLOWLIST=
# Lookback is longer than lookahead because order-confirmation emails typically precede the card charge.
EMAIL_LOOKBACK_DAYS=10
EMAIL_LOOKAHEAD_DAYS=5
EMAIL_MAX_RESULTS_PER_SEARCH=10
EMAIL_MAX_CANDIDATES=5
EMAIL_BODY_BYTE_CAP=65536
ENRICHMENT_CONFIDENCE_THRESHOLD=0.8
# Local demo fixture for EMAIL_PROVIDER=fake: JSON array of EmailMessage-shaped rows.
# EMAIL_FAKE_FIXTURE=
# Regex extractor is a bootstrap; EXTRACTION_MODEL is the intended default.
# EXTRACTION_MODEL=

# Gmail REST (EMAIL_PROVIDER=gmail_rest) and Gmail MCP (EMAIL_PROVIDER=gmail).
# GMAIL_ACCESS_TOKEN is the preferred static token; EMAIL_MCP_ACCESS_TOKEN is the fallback.
# Either static token wins over the GMAIL_OAUTH_* refresh-token trio.
# GMAIL_REST_BASE_URL=https://gmail.googleapis.com/gmail/v1/users/me/
# GMAIL_REST_TIMEOUT_S=20
# GMAIL_ACCESS_TOKEN=
# EMAIL_MCP_URL=https://gmailmcp.googleapis.com/mcp/v1
# EMAIL_MCP_TIMEOUT_S=20
# EMAIL_MCP_ACCESS_TOKEN=
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# GMAIL_OAUTH_REFRESH_TOKEN=

# Observability (optional). Traces contain transaction data; see README Observability.
# LANGSMITH_TRACING=true          # enable LangSmith tracing (SDK reads this; no app code)
# LANGSMITH_API_KEY=              # authenticate trace uploads to LangSmith cloud
# LANGSMITH_PROJECT=finance-agent # group traces under this project name
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com  # US default; use https://eu.api.smith.langchain.com for EU
# LANGSMITH_HIDE_INPUTS=true      # hide all span inputs (hides task strings tracing exists to show)
# LANGSMITH_HIDE_OUTPUTS=true     # hide all span outputs
